# CLIPZ configuration. Copy to `.env` and edit.
# Secrets stay server-side: nothing here is exposed to the frontend.

# --- AI highlight model (PRD 8.5) -------------------------------------------
# Any OpenAI-compatible endpoint works. Leave OX_API_KEY unset to run the
# deterministic heuristic provider instead (no network, lower quality).
# These are the fallback: anything entered in the app's Settings panel (stored
# in storage/runtime_config.json) takes priority over the values here.
OX_API_KEY=
OX_BASE_URL=https://api.ox.ai/v1
OX_MODEL=ox-alpha
# AI_PROVIDER=openai_compatible   # or `heuristic` to force offline selection
# AI_TEMPERATURE=0.4
# AI_TIMEOUT_S=180
# AI_MAX_RETRIES=2
# AI_REPAIR_ATTEMPTS=1
# A transcript longer than this is analysed in overlapping sections, each its
# own concurrent model call, instead of being truncated. Lower it for models
# with a small context window.
# AI_MAX_PROMPT_CHARS=120000
# AI_CHUNK_CONCURRENCY=3

# --- Transcription ----------------------------------------------------------
# tiny | base | small | medium | large-v3 -- larger is slower and more accurate.
WHISPER_MODEL=base
# WHISPER_DEVICE=auto            # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=default   # float16 on GPU, int8 on CPU
# WHISPER_LANGUAGE=              # blank autodetects
# WHISPER_BATCH_SIZE=0           # 0 = auto (16 on CUDA, sequential on CPU)
# WHISPER_CPU_THREADS=0          # 0 = auto (half the cores, capped at 8)

# --- Rendering --------------------------------------------------------------
# VIDEO_ENCODER=auto             # auto | libx264 | h264_nvenc | h264_vaapi
# RENDER_CONCURRENCY=0           # clips encoded at once; 0 = auto
# VIDEO_CRF=20
# OUTPUT_WIDTH=1080
# OUTPUT_HEIGHT=1920
# OUTPUT_FPS=30
# REFRAME_MODE=smart             # smart | crop | blur_pad
#   smart tracks the largest detected face and pans the crop to follow it,
#   falling back to a plain centred crop automatically (never fails a render)
#   when no face is found. crop is the old always-centred behaviour.
# FACE_DETECT_CONFIDENCE=0.6
# FACE_SAMPLE_INTERVAL_S=0.5
# FACE_PAN_EMA_ALPHA=0.25         # higher = snappier pan, lower = smoother
# FACE_PAN_MAX_SPEED=0.6          # cap, fraction of scaled width per second
# FACE_VERTICAL_ANCHOR=0.42       # where the face sits vertically, 0=top 1=bottom

# --- Captions ---------------------------------------------------------------
# DEFAULT_CAPTION_STYLE=dynamic  # classic | highlight | dynamic | chunks | karaoke
# CAPTION_FONT=DejaVu Sans
# CAPTION_FONT_SIZE=96

# --- Selection and ranking --------------------------------------------------
# MIN_CLIP_DURATION=15
# MAX_CLIP_DURATION=90
# OVERLAP_THRESHOLD=0.70
# WEIGHT_AI_SCORE=0.50
# WEIGHT_HOOK=0.15
# WEIGHT_EMOTION=0.10
# WEIGHT_SPEECH_DENSITY=0.10
# WEIGHT_DURATION_FIT=0.05
# WEIGHT_CONFIDENCE=0.05
# WEIGHT_NOVELTY=0.05

# --- Downloads --------------------------------------------------------------
# YTDLP_CONCURRENT_FRAGMENTS=4   # parallel fragment fetches; the main speed dial
# Age-restricted and members-only videos need a signed-in session. Use one of:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt        # Netscape format
# YTDLP_COOKIES_FROM_BROWSER=firefox             # chrome | firefox | brave | edge

# --- Runtime ----------------------------------------------------------------
# WORKER_COUNT=1                 # jobs at a time (clips inside one run parallel)
# KEEP_INTERMEDIATE_FILES=false  # true keeps downloads/audio/transcripts
# RECOVER_JOBS_ON_STARTUP=true   # re-queue what never ran, fail what was running
# DATABASE_URL=sqlite:///storage/clipz.db

# --- Logging ----------------------------------------------------------------
# LOG_TO_FILE=true               # storage/logs/clipz.log, rotated
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_BACKUPS=3
# LOG_RETENTION_DAYS=7           # how long per-render FFmpeg logs are kept

# --- Access control ---------------------------------------------------------
# Unset means the API is open, which is correct for one user on localhost.
# Set it before binding anywhere else: every /api call then needs the token,
# as `Authorization: Bearer ...`, `X-API-Key: ...`, or the cookie the UI sets.
# API_TOKEN=

# --- Publishing to TikTok ---------------------------------------------------
# From an app you create at https://developers.tiktok.com with the Content
# Posting API product added and Direct Post enabled.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok rejects localhost and 127.0.0.1 as a redirect URI, whatever the
# scheme, so the callback needs a public HTTPS hostname forwarding here (a
# tunnel or reverse proxy). Register it in the portal character for character.
# Set API_TOKEN as well: a tunnel puts this API on the internet.
# TIKTOK_REDIRECT_URI=https://your-stable-hostname.example/api/accounts/tiktok/callback
# Request only the scopes your app has been granted. Content Posting must be
# approved before video.publish and video.upload will work; until then a login
# asking for them fails with an error naming client_key.
# TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
# DEFAULT_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE  # SELF_ONLY until your app is audited
# PUBLISH_CONCURRENCY=4        # how many accounts post at the same time
# PUBLISH_MAX_ATTEMPTS=3
#
# --- Automatic posting (PRD 8.10 mode 4) ------------------------------------
# When on, every job that finishes renders its clips straight to every
# connected TikTok account -- no button press. The Settings panel toggle
# (stored in storage/runtime_config.json) wins over this. It only affects
# jobs completing while it is on; nothing is back-filled.
# AUTO_PUBLISH=false
# AUTO_PUBLISH_MAX_CLIPS=0     # 0 = every rendered clip; cap the burst otherwise
#
# Upload to each account's TikTok drafts instead of direct posting -- the
# mode that works before your TikTok app is audited. The creator finishes
# each post from the TikTok app (2 taps, any privacy).
# PUBLISH_AS_DRAFT=false
